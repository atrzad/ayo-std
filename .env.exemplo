# Ayo Std — produção nesta máquina
PORTA=3300
# O Node só escuta em localhost; o acesso de fora chega pelo Tailscale Funnel
# (tailscale funnel --bg --https=8443 3300), que faz o HTTPS e repassa para cá.
HOST=127.0.0.1
DATA_DIR=~/.local/share/ayo-std
# Endereço público aceito no cabeçalho Host (o resto recebe 421).
HOSTS_EXTRAS=nossos-dias.tail9ff58.ts.net
# Confia no X-Forwarded-For/Proto só do proxy local (Tailscale): IP real no limite de login e cookie Secure no HTTPS.
TRUST_PROXY=true
